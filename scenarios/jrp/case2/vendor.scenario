when "jrp_dragon_strike == 1" -> :after
when "jrp_dragon_vendor == 1" -> :again
text "Лавочник: Вы за крупой? Берите в долг. До вторника я всё равно не откроюсь." second=jrp/village_vendor key=jrp/case2/vendor/rewrite0
text "Стас: Выходные?" first=jrp/stas key=jrp/case2/vendor/rewrite1
text "Лавочник: Запой. Во вторник прилетит дракон, всех убьёт. В среду воскресят — и можно по новой." second=jrp/village_vendor key=jrp/case2/vendor/rewrite2
text "Стас: Вас это устраивает?" first=jrp/stas key=jrp/case2/vendor/rewrite3
text "Лавочник: Дракон мешает. Самый разгар — и опять умирать. Если б не он, вообще бы жизнь наладилась." second=jrp/village_vendor key=jrp/case2/vendor/rewrite4
text "Стас: А если убрать налёты совсем?" first=jrp/stas key=jrp/case2/vendor/rewrite5
text "Лавочник: В смысле, до конца месяца дожить? А кто тогда долги обнулит? Хотя погоди. Долги-то не обнуляют." second=jrp/village_vendor key=jrp/case2/vendor/rewrite6
text "Стас: Кто дракону план выдаёт?" first=jrp/stas key=jrp/case2/vendor/rewrite7
text "Лавочник: Распорядитель наверху. Дракон к нему с мазью для горла ходил, просил перерыв. Получил ещё деревню." second=jrp/village_vendor key=jrp/case2/vendor/rewrite8
flag jrp_dragon_vendor 1
goto -> :case2_sync
:again
text "Лавочник: К распорядителю — по тропе справа. Попроси показать, кто подписал план. Обычно после этого люди перестают улыбаться." second=jrp/village_vendor key=jrp/case2/vendor/5
goto -> :case2_sync
:after
text "Лавочник: Дверей сегодня не продал. Сначала испугался. Потом вспомнил, что моя тоже на месте." second=jrp/village_vendor key=jrp/case2/vendor/6
goto -> :case2_sync

:case2_sync
when "jrp_dragon_complete == 1" -> :case2_stage11
when "jrp_dragon_verified == 1" -> :case2_stage10
when "jrp_dragon_strike == 1" -> :case2_stage9
when "jrp_dragon_registered == 1" -> :case2_stage8
when "jrp_dragon_letter_sent == 1" -> :case2_stage7
when "jrp_dragon_signed == 1" -> :case2_stage6
when "jrp_dragon_draft == 1" -> :case2_stage5
when "jrp_dragon_legal_advice == 1" -> :case2_stage4
when "jrp_dragon_plan == 1" -> :case2_stage3
when "jrp_dragon_forewoman == 1 && jrp_dragon_healer == 1 && jrp_dragon_vendor == 1 && jrp_dragon_notice == 1 && jrp_dragon_marshal == 1" -> :case2_stage2
when "jrp_dragon_village == 1" -> :case2_stage1
when "jrp_dragon_started != 1" -> :case2_end
action quest.set_data_status quest_id=jrp_dragon_case level=0
end
:case2_stage1
action quest.set_data_status quest_id=jrp_dragon_case level=1
end
:case2_stage2
action quest.set_data_status quest_id=jrp_dragon_case level=2
end
:case2_stage3
action quest.set_data_status quest_id=jrp_dragon_case level=3
end
:case2_stage4
action quest.set_data_status quest_id=jrp_dragon_case level=4
end
:case2_stage5
action quest.set_data_status quest_id=jrp_dragon_case level=5
end
:case2_stage6
action quest.set_data_status quest_id=jrp_dragon_case level=6
end
:case2_stage7
action quest.set_data_status quest_id=jrp_dragon_case level=7
end
:case2_stage8
action quest.set_data_status quest_id=jrp_dragon_case level=8
end
:case2_stage9
action quest.set_data_status quest_id=jrp_dragon_case level=9
end
:case2_stage10
action quest.set_data_status quest_id=jrp_dragon_case level=10
end
:case2_stage11
action quest.set_data_status quest_id=jrp_dragon_case level=11
end
:case2_end
end
