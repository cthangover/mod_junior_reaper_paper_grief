when "jrp_case_complete != 1" -> :locked
flag jrp_personal_desk_used 1
ptext "На своём столе Стас раскладывает закрытое дело Глеба. Улики и показания остаются в папке; новая обложка не превращает их в новое поручение." key=jrp/bureau/personal/desk
text "Стас: Следующее дело начну с разговора. Таблицу успею." key=jrp/bureau/personal/quiet first=jrp/stas
end
:locked
ptext "На служебном пропуске: «Рабочее место — кабинет Смерти. Отдельный кабинет после первого закрытого дела». Дверь пока опломбирована." key=jrp/bureau/door/locked
end
