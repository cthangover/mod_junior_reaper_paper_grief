action quest.set_data_status quest_id=jrp_guard_case level=8
end
:progress_7
action quest.set_data_status quest_id=jrp_guard_case level=7
end
:progress_6
action quest.set_data_status quest_id=jrp_guard_case level=6
end
:progress_5
action quest.set_data_status quest_id=jrp_guard_case level=5
end
:progress_4
action quest.set_data_status quest_id=jrp_guard_case level=4
end
:progress_3
action quest.set_data_status quest_id=jrp_guard_case level=3
end
:progress_2
action quest.set_data_status quest_id=jrp_guard_case level=2
end
:progress_1
action quest.set_data_status quest_id=jrp_guard_case level=1
end
